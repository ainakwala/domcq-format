{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domcq.com/schema/v1",
  "title": "domcq/1 question set",
  "description": "A set of multiple-choice questions in the domcq/1 format, as produced by a student's own AI from the DoMcq prompt and imported into DoMcq (https://domcq.com). Structural rules only; see https://github.com/kamranrashid-com/domcq-format/blob/main/SPEC.md for the cross-field and module rules the reference validator also applies.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "domcq/1"
    },
    "exam": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "set": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "questions": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "stem": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "options": {
            "minItems": 2,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "answer": {
            "type": "string",
            "pattern": "^[A-F]+$"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "subtopic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "rationales": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E",
                "F"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "required": [
          "stem",
          "options",
          "answer",
          "explanation",
          "topic"
        ],
        "additionalProperties": false
      }
    },
    "exported_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      ]
    }
  },
  "required": [
    "format",
    "set",
    "questions"
  ],
  "additionalProperties": false
}
